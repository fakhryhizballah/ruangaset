NODE_ENV=development
PORT=4000
APP_NAME=RuangAset

# MongoDB Atlas production URI or local MongoDB URI. Do not commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/ruangaset

# Generate an RSA private/public key pair. Put PEM text here; escaped \\n is supported.
# openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:3072
# openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER=ruangaset-api
JWT_AUDIENCE=ruangaset-web
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# Comma-separated exact frontend origins.
CORS_ORIGINS=http://localhost:3000
COOKIE_NAME=ra_refresh
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
REGISTER_ENABLED=true

# Used only by the seed:admin script. Set a strong unique password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
